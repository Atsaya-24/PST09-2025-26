    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="fahren" type="Integer" array="False" size=""/>
            <declare name="c" type="Integer" array="False" size=""/>
            <assign variable="c" expression="35"/>
            <assign variable="fahren" expression="(9/5*c)+32"/>
            <output expression="&quot;the fahrenheit of 35 degree celcious is&quot; &amp;fahren" newline="True"/>
        </body>
    </function>
