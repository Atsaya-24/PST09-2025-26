    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="a" type="Integer" array="False" size=""/>
            <assign variable="a" expression="316"/>
            <if expression="a%2==0">
                <then>
                    <output expression="&quot;it is an even number&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;it is an odd number&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
